# Copy this file to .env.local and set a long random value (32+ characters), for example:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
#
# It signs the game sessions. Without it the server makes up a temporary secret
# on every start, which is fine locally but breaks when more than one server
# instance (or a serverless host) handles the site.
GAME_SECRET=
